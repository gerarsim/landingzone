# ── LZForge .env.example ─────────────────────────────────────────────
# Copy to .env and fill in ONLY the Terraform remote state settings.
# Azure SP credentials are NO LONGER stored here — they are collected
# per-job via the web form and passed directly to the worker.
#
# Redis encryption key is auto-managed — no manual configuration needed.

# ── Terraform Remote State (Azure Storage Account) ────────────────────
# Create once before first run:
#   az group create --name rg-lzforge-tfstate --location westeurope
#   az storage account create --name lzforgetfstate --resource-group rg-lzforge-tfstate \
#     --location westeurope --sku Standard_LRS
#   az storage container create --name tfstate --account-name lzforgetfstate
#
# The worker can also auto-create these on first run if you supply the SP via the form.

TFSTATE_STORAGE_ACCOUNT=lzforgetfstate
TFSTATE_RESOURCE_GROUP=rg-lzforge-tfstate
TFSTATE_CONTAINER=tfstate
