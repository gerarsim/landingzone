AZURE_CLIENT_ID=<your-service-principal-app-id>
AZURE_CLIENT_SECRET=<your-secret>
AZURE_TENANT_ID=<your-tenant-id>
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
enable_firewall     = true   # adds Azure Firewall to hub
enable_vpn_gateway  = true   # adds VPN Gateway
enable_bastion      = true   # always recommended
monthly_budget      = 2000
spoke_address_spaces = { workloads = "10.1.0.0/16", dmz = "10.2.0.0/16" }